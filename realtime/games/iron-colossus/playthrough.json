{
  "interaction_events": [
    "building.hit",
    "ground.stomped",
    "flame.breathed",
    "player.moved"
  ],
  "restart_actions": [
    {
      "type": "tap",
      "key": "Enter"
    }
  ],
  "scenarios": [
    {
      "expect": "WON",
      "rules": [
        {
          "when": {
            "building.error": {
              "$gt": 0.06
            }
          },
          "hold": [
            "ArrowRight"
          ]
        },
        {
          "when": {
            "building.error": {
              "$lt": -0.06
            }
          },
          "hold": [
            "ArrowLeft"
          ]
        },
        {
          "when": {
            "building.distance": {
              "$gt": 11
            }
          },
          "hold": [
            "w"
          ]
        },
        {
          "when": {
            "building.distance": {
              "$lt": 13
            }
          },
          "hold": [
            "f"
          ]
        },
        {
          "when": {
            "building.distance": {
              "$lt": 7
            },
            "stompCd": 0
          },
          "action": {
            "type": "tap",
            "key": " "
          },
          "cooldown_ms": 1000
        }
      ]
    },
